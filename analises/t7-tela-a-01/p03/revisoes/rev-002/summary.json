        "itens": [
          {
            "seletor": "#forma-presencial",
            "regra": "label",
            "observado": "O rádio 'Presencial' tem um <label> irmão sem atributo for e não está envolvido por ele. Não tem aria-label, então fica sem nome acessível (aparece como 'radio' sem nome na árvore). Clicar no texto 'Presencial' também não marca a opção."
          },
          {
            "seletor": ".upload-button",
            "regra": "aria-hidden-focus",
            "observado": "O botão 'Selecione o arquivo' tem aria-hidden='true' e é focável (tabindex='1'). O input file #documentos está com display:none, então o único controle de upload fica oculto para tecnologias assistivas e recebe foco sem nome."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:2.4.3",
            "observado": "tabindex='1' (positivo) no botão de upload. O primeiro Tab após o carregamento vai direto para esse botão, no meio do formulário, antes do skiplink 'Ir para o conteúdo' e dos campos anteriores."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": "wcag:2.4.7",
            "observado": "Com foco pelo teclado nos campos 'Tipo de serviço' e 'Unidade de atendimento': outline-style none, box-shadow none e borda inalterada (1px #888), também no .input-group e no .br-input. Nenhum indicador visível na captura de tela. Para comparação, #nome mostra box-shadow 0 0 0 2px rgb(194,133,12)."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": "wcag:1.3.1",
            "observado": "Após Enviar com o formulário vazio, #servico e #unidade recebem aria-invalid='true' sem aria-describedby. As mensagens 'Selecione o tipo de serviço.' e 'Selecione a unidade de atendimento.' não têm id e não estão associadas ao campo. Os demais campos (nome, cpf, data, descrição, forma, declaração) apontam para as mensagens deles."
          },
          {
            "seletor": ".flatpickr-prev-month > button, .flatpickr-next-month > button",
            "regra": "emag-2.2",
            "observado": "Os botões de mês anterior e próximo do calendário do datepicker contêm só um ícone e não têm aria-label nem texto, então ficam sem nome acessível."
          },
          {
            "seletor": "header.barra-superior",
            "regra": "ds-page-header",
            "observado": "A página usa <header class='barra-superior'> só com a marca gov.br; não há .br-header nem <br-header> no documento."
          },
          {
            "seletor": "body",
            "regra": "ds-page-footer",
            "observado": "O documento não tem .br-footer nem <br-footer>; a página termina na paginação do histórico."
          },
          {
            "seletor": ".mensagem-retorno .close > [role=\"button\"]",
            "regra": "ds-structure-button-tag",
            "observado": "Na mensagem de erro (br-message danger), o botão 'Fechar a mensagem' é um <div class='br-button circle small' role='button' tabindex='0'>. A mensagem de sucesso usa <button>."
          },
          {
            "seletor": ".dialogo-descarte",
            "regra": "ds-token-color",
            "observado": "O modal 'Descartar solicitação?' usa color: rgb(51, 67, 51) (#334333), valor que não pertence ao registro de tokens do DS (o mais próximo é --green-cool-70, #37493b)."
          },
          {
            "seletor": ".acao-cancelar",
            "regra": "wcag:2.4.3",
            "observado": "Ao fechar o modal 'Descartar solicitação?' com Esc ou com 'Continuar preenchendo', o foco vai para <body> (document.activeElement = BODY) em vez de voltar ao botão Cancelar que abriu o modal."
          }
        ]
      },
