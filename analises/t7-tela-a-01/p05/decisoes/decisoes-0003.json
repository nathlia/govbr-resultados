      "status": "reviewed",
      "reviewer": "agente-revisor-opus (cego)",
      "rationale": "Parcial. aria-hidden=\"true\" no .upload-button é escrito pelo próprio BRUpload do core do DS (e.setAttribute('aria-hidden','true') no bundle), não pela página; o tabindex=1 é da página, mas a alegação principal (aria-hidden em focável) é comportamento do componente.",
      "complete": true,
      "evidenceRefs": [
        "medição própria na página congelada (Playwright headless 1280x900)",
        "cartão"
      ],
      "atoms": [
        {
          "id": "a1",
          "text": "O botão 'Selecione o arquivo' tem aria-hidden=\"true\", mas recebe foco (tabindex=1). Como o input file #documentos está com display:none, o upload fica sem controle acessível para leitores de tela (o botão aparece sem nome).",
          "subjects": [
            "body>div:nth-of-type(1)>div>main>form>div:nth-of-type(6)>div>button"
          ],
          "unitIds": [],
          "citation": "uncertain",
