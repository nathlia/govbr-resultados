      "achados": {
        "total": 9,
        "itens": [
          {
            "seletor": "#forma-presencial",
            "regra": "wcag:4.1.2",
            "observado": "O rádio 'Presencial' não tem nome acessível (árvore de acessibilidade: 'radio' sem nome); o <label>Presencial</label> não tem atributo for e não envolve o input. Clicar no texto 'Presencial' não marca a opção (checked permaneceu false)."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:4.1.2",
            "observado": "O botão 'Selecione o arquivo' tem aria-hidden=\"true\" mas é focável (tabindex=\"1\") e é o único controle de upload visível (input#documentos está display:none); fica ausente da árvore de acessibilidade, sem nome/papel para tecnologia assistiva."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:2.4.3",
            "observado": "tabindex=\"1\" no botão de upload: ao pressionar Tab a partir do carregamento, ele é o primeiro elemento focado, antes do link 'Ir para o conteúdo', da marca e da trilha; ao final da página o foco também volta a ele."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": "wcag:2.4.7",
            "observado": "Ao receber foco por teclado (classe focus-visible aplicada), os campos 'Tipo de serviço' e 'Unidade de atendimento' ficam com outline-style none e box-shadow none, sem mudança visual no campo ou no contêiner; os demais campos de texto mostram anel de foco #C2850C."
          },
          {
            "seletor": ".grupo-forma .br-radio > label, .br-checkbox > label",
            "regra": "wcag:1.4.11",
            "observado": "O círculo/quadrado que representa rádios e caixas de seleção (label::before) tem borda 1px rgb(204,204,204) sobre fundo branco, contraste ~1,6:1; é o único limite visual do controle não marcado."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": "wcag:1.3.1",
            "observado": "Após envio vazio, as mensagens 'Selecione o tipo de serviço.' e 'Selecione a unidade de atendimento.' são span.feedback sem id, e #servico/#unidade recebem aria-invalid=\"true\" sem aria-describedby; nos demais campos a mensagem tem id e é referenciada por aria-describedby."
          },
          {
            "seletor": ".acao-cancelar",
            "regra": "wcag:2.4.3",
            "observado": "Ao fechar o diálogo 'Descartar solicitação?' com Esc ou com 'Continuar preenchendo', o foco vai para <body>, não retorna ao botão Cancelar que abriu o diálogo."
          },
          {
            "seletor": ".paginacao-anteriores .page.active",
            "regra": "wcag:1.3.1",
            "observado": "A página atual da paginação é indicada só visualmente (classe active, fundo azul); o link não tem aria-current, nem antes nem depois de navegar para a página 2."
          },
          {
            "seletor": ".flatpickr-prev-month > button, .flatpickr-next-month > button",
            "regra": "wcag:4.1.2",
            "observado": "Com o calendário aberto, os botões de mês anterior/seguinte contêm só ícone (<i> sem texto alternativo) e não têm aria-label; nome acessível vazio na árvore de acessibilidade."
          }
        ]
      },
