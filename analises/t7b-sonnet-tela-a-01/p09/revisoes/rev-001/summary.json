      "achados": {
        "total": 10,
        "itens": [
          {
            "seletor": "#forma-presencial",
            "regra": "wcag:4.1.2",
            "observado": "O rótulo \"Presencial\" é um label sem atributo for; o radio #forma-presencial aparece na árvore de acessibilidade sem nome (radio sem nome), ao contrário dos outros dois."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:4.1.2",
            "observado": "O botão \"Selecione o arquivo\" tem aria-hidden=\"true\" mas é focável (tabindex=1); o input file #documentos está com display:none, então o único controle operável fica oculto das tecnologias assistivas e sem nome na árvore."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:2.4.3",
            "observado": "O botão de upload tem tabindex=\"1\"; ao pressionar Tab após o carregamento o foco vai primeiro para ele, antes do link \"Ir para o conteúdo\" e do restante da página."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": "wcag:2.4.7",
            "observado": "Ao receber foco por teclado, os campos de combobox têm outline none e box-shadow none; no input, no .input-group e no .br-input não há indicador visível, enquanto os demais campos exibem box-shadow âmbar de 2px."
          },
          {
            "seletor": ".flatpickr-prev-month button, .flatpickr-next-month button",
            "regra": "wcag:4.1.2",
            "observado": "Os botões de mês anterior e mês seguinte do calendário são só ícone, sem texto, aria-label ou title; não têm nome acessível."
          },
          {
            "seletor": ".flatpickr-monthDropdown-months, .flatpickr-current-month .cur-year",
            "regra": "wcag:3.1.2",
            "observado": "O seletor de mês e o campo de ano do calendário têm aria-label em inglês (\"Month\", \"Year\") em uma página pt-BR."
          },
          {
            "seletor": "#cpf",
            "regra": "wcag:3.3.1",
            "observado": "O valor \"123\" foi aceito: o envio teve sucesso, sem erro, embora o texto de apoio exija 11 dígitos."
          },
          {
            "seletor": "#data-preferencial",
            "regra": "wcag:3.3.1",
            "observado": "O texto \"99/99/2020\" foi aceito e convertido em silêncio para \"08/03/2028\"; o envio teve sucesso, sem erro."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": "wcag:3.3.1",
            "observado": "Após o envio vazio, #servico e #unidade ficam com aria-invalid=\"true\" mas sem aria-describedby; as mensagens \"Selecione o tipo de serviço.\" e \"Selecione a unidade de atendimento.\" não têm id e não se associam ao campo (os outros campos associam)."
          },
          {
            "seletor": ".paginacao-anteriores .page.active",
            "regra": null,
            "observado": "Após clicar em \"Página 2\", a página atual só se distingue visualmente (classe active); o link não tem aria-current=\"page\"."
          }
        ]
      },
