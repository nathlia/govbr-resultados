          {
            "seletor": "#forma-presencial",
            "regra": "wcag:4.1.2",
            "observado": "O input radio 'Presencial' não tem nome acessível: o <label> não tem atributo for e não envolve o input; a árvore de acessibilidade mostra radio sem nome (os outros dois têm)."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:4.1.2",
            "observado": "Botão 'Selecione o arquivo' tem aria-hidden=\"true\" mas é focável e recebe o foco (foi o primeiro elemento focado ao pressionar Tab); o input file real está com display:none."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:2.4.3",
            "observado": "O botão tem tabindex=\"1\" (positivo); ao pressionar Tab no carregamento ele recebe o foco antes do link de salto e de todos os demais controles, fora da ordem visual."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": null,
            "observado": "Após envio vazio, a mensagem de erro de cada combo ('Selecione o tipo de serviço.', 'Selecione a unidade de atendimento.') não tem id e os inputs têm só aria-invalid=true, sem aria-describedby; nos demais campos a mensagem é associada via aria-describedby."
          },
          {
            "seletor": "#cpf",
            "regra": "wcag:3.3.1",
            "observado": "CPF '123' (3 dígitos, contra a orientação '11 dígitos') foi aceito sem erro e a solicitação foi enviada com sucesso."
          },
          {
            "seletor": "#data-preferencial",
            "regra": "wcag:3.3.1",
            "observado": "Data inexistente '31/02/2027' foi aceita sem erro e substituída silenciosamente por '03/03/2027' no campo; envio concluído com sucesso."
          },
          {
            "seletor": ".flatpickr-prev-month button, .flatpickr-next-month button",
            "regra": "wcag:4.1.2",
            "observado": "Os botões de mês anterior/seguinte do calendário são só ícone (<i>) e não têm texto nem aria-label."
          },
          {
            "seletor": ".paginacao-anteriores .page.active",
            "regra": "wcag:4.1.2",
            "observado": "Após clicar em 'Página 2', o link ativo só tem a classe 'active'; sem aria-current (null) ou outro indicador programático da página atual."
          }
        ]
      },
