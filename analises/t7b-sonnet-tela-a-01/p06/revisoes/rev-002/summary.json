          {
            "seletor": ".upload-button",
            "regra": "wcag:2.4.3",
            "observado": "tabindex=\"1\" (positivo): ao pressionar Tab pela primeira vez o foco vai direto ao botão de upload, no meio do formulário, antes do link de salto e dos campos iniciais"
          },
          {
            "seletor": ".flatpickr-prev-month > button, .flatpickr-next-month > button",
            "regra": "emag-2.2",
            "observado": "Botões de mês anterior/seguinte do calendário contêm só ícone, sem aria-label nem texto; sem nome acessível"
          },
          {
            "seletor": ".flatpickr-monthDropdown-months, .flatpickr-current-month .cur-year",
            "regra": "wcag:3.1.2",
            "observado": "Seletor de mês e campo de ano do calendário têm aria-label em inglês (\"Month\", \"Year\") em página pt-BR"
          },
          {
            "seletor": "html",
            "regra": "ds-page-header",
            "observado": "Não há componente .br-header nem <br-header>; o topo é um <header class=\"barra-superior\"> customizado só com a marca"
          },
          {
