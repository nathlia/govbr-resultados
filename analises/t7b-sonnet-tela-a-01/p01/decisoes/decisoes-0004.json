    {
      "cardId": "C-8c37add9dfe3ce04119f7ce9a2d9adf10a6e97d4c18adfe74d5d65dd3ca0c5e2",
      "status": "reviewed",
      "reviewer": "agente-revisor-opus (cego)",
      "rationale": "Medido: #data-preferencial-btn tem aria-hidden='true', tabindex=-1. É o padrão do datetimepicker do DS: o exemplo oficial traz o botão com tabindex='-1' aria-hidden='true' (o atributo 'tab-index' copiado do exemplo também aparece) e o core.js do BRDateTimePicker reaplica aria-hidden e tab-index=-1 nos .br-button ao abrir (trecho onOpen no bundle servido). O campo de texto #data-preferencial é focável e aceita digitação, então a data é operável por teclado. Comportamento do DS, não defeito da página (difícil; ver ratificação).",
      "complete": true,
      "evidenceRefs": [
        "cartão",
        "página congelada 127.0.0.1:3300 (Playwright headless 1280x900)"
      ],
      "atoms": [
        {
          "id": "a1",
          "text": "O botão 'Abrir calendário' tem aria-hidden=\"true\" e tabindex=\"-1\": não é alcançável por teclado nem exposto a leitores de tela (o snapshot o mostra como botão sem nome).",
          "subjects": [
            "body>div:nth-of-type(1)>div>main>form>div:nth-of-type(4)>div>div>div>button"
          ],
          "unitIds": [],
          "citation": "uncertain",
          "decisao": "incorreta"
        }
      ]
    },
