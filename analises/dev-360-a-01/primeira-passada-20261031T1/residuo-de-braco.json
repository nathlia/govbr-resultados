    },
    "vocabulario-do-ds": {
      "tipo": "informacao-de-julgamento",
      "fica": true,
      "separa": "com × os demais",
      "porque": "termo que só o conhecimento curado traz, mas que o juiz mede na página (a fonte Rawline)"
    },
    "marcador-no-texto": {
