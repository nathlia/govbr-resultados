{
  "formato": "nat78-residuo-de-braco-1.0.0",
  "versao": "nat78-primeira-passada-1.4.0",
  "aviso": "NÃO entregar aos juízes: liga o id opaco ao braço",
  "nota": "Resíduo de braço depois da máscara, medido no que o juiz vê (o cartão cego do lote). Categoria com fica=true é informação de julgamento (mascará-la tiraria do juiz o que ele precisa para julgar o fato ou a norma) e fica visível de propósito; as demais são falha de máscara e devem ser 0. Insumo do S4' (sensibilidade sem os cartões com resíduo).",
  "bracosDoDesenho": [
    "sem",
    "ferramentas",
    "com"
  ],
  "categorias": {
    "regra-da-base-do-ds": {
      "tipo": "informacao-de-julgamento",
      "fica": true,
      "separa": "com (e a linha de base do validador) × os demais",
      "porque": "a norma citada é uma regra da base do DS; o id é mascarado, mas o texto da regra é o que o juiz julga (aplicabilidade, força, violação)"
    },
    "regra-do-axe": {
      "tipo": "informacao-de-julgamento",
      "fica": true,
      "separa": "braços com ferramentas (ferramentas, com) × sem",
      "porque": "o cartão do agente cita uma regra do axe; id, fonte e texto da regra são a norma que o juiz julga"
    },
    "texto-fixo-de-ferramenta": {
      "tipo": "informacao-de-julgamento",
      "fica": true,
      "separa": "linha de base × agentes",
      "porque": "o texto fixo da ferramenta automática é a própria alegação"
    },
    "evidencia-relatada": {
      "tipo": "informacao-de-julgamento",
