{
  "padrao": {
    "width": 1280,
    "height": 900
  },
  "extras": [],
  "setup": [
    {
      "action": "click",
      "selector": "govbr-custom-pagination nav > div:nth-of-type(1) br-select-pnip input#total"
    },
    {
      "action": "wait",
      "selector": "govbr-custom-pagination nav > div:nth-of-type(1) br-select-pnip .br-list .br-item"
    },
    {
      "action": "navigate",
      "path": "/pnip-f2/portal-mpa/vistorias",
      "waitFor": "pnip-propesc-vistorias"
    },
    {
      "action": "navigate",
      "path": "/pnip-f2/portal-mpa/processos",
      "waitFor": "pnip-mpa-processos .br-table tbody tr"
    },
    {
      "action": "click",
      "selector": "pnip-multiple-search-table-utils div.row.align-items-center > div.col-auto.px-1:first-child > span.br-tag"
    },
    {
      "action": "wait",
      "selector": "pnip-multiple-search-table-utils div.br-select > div.br-list > div.br-item"
    },
    {
      "action": "click",
      "selector": "pnip-multiple-search-table-utils div.br-select > div.br-list > div.br-item:nth-child(3) .br-radio"
    },
    {
      "action": "wait",
      "selector": "pnip-multiple-search-table-utils div.row.pl-2:not(.align-items-center) span.br-tag.interaction"
    },
    {
      "action": "wait",
      "ms": 1000
    }
  ],
  "waitFor": "main .br-table tbody tr",
  "url": "/pnip-f2/portal-mpa/processos?mock-perfil=mpa",
  "paradas": [
    {
      "id": "inicial",
      "afterStep": 0,
      "path": "/pnip-f2/portal-mpa/processos"
    },
    {
      "id": "lista-exibir",
      "afterStep": 2,
      "path": "/pnip-f2/portal-mpa/processos"
    },
    {
      "id": "filtro-escolhido",
      "afterStep": 9,
      "path": "/pnip-f2/portal-mpa/processos"
    }
  ]
}
