      "achados": {
        "total": 7,
        "itens": [
          {
            "seletor": "#forma-presencial",
            "regra": null,
            "observado": "O rádio \"Presencial\" não tem nome acessível: o label não tem atributo for nem envolve o input; clicar no texto não seleciona a opção (árvore de acessibilidade: radio sem nome)."
          },
          {
            "seletor": ".upload-button",
            "regra": "wcag:2.4.3",
            "observado": "O botão \"Selecione o arquivo\" tem tabindex=\"1\": na tabulação recebe foco antes do link \"Ir para o conteúdo\" e fora da ordem visual, que o põe no meio do formulário."
          },
          {
            "seletor": ".upload-button",
            "regra": null,
            "observado": "O botão de upload, focável e visível, tem aria-hidden=\"true\", e o input file real está com display:none; a ação de anexar fica oculta das tecnologias assistivas."
          },
          {
            "seletor": ".paginacao-anteriores .page.active",
            "regra": null,
            "observado": "A página atual da paginação (1) só se distingue pela cor/fundo (classe active); não há aria-current=\"page\" nela, nem ao mudar para a página 2."
          },
          {
            "seletor": "#servico, #unidade",
            "regra": null,
            "observado": "Após Enviar vazio, os campos têm aria-invalid=\"true\", mas as mensagens de erro (\"Selecione o tipo de serviço.\", \"Selecione a unidade de atendimento.\") não estão ligadas por aria-describedby (sem id); nos demais campos há associação."
          },
          {
            "seletor": "#cpf",
            "regra": null,
            "observado": "Com CPF \"123\" (a instrução diz 11 dígitos), o envio foi aceito e exibiu \"Solicitação enviada.\" sem erro no campo."
          },
          {
            "seletor": "#data-preferencial",
            "regra": null,
            "observado": "A entrada \"99/99/9999\" foi convertida silenciosamente para \"09/03/0007\" e o envio foi aceito."
          }
        ]
      },
