          },
          {
            "seletor": "#forma-presencial",
            "regra": "wcag:4.1.2",
            "observado": "O rádio \"Presencial\" não tem nome acessível: o <label>Presencial</label> não tem atributo for; na árvore aparece como radio sem nome e clicar no rótulo não seleciona a opção."
          },
